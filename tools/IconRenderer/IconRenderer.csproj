<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer tool (not part of the solution, not shipped). Renders the app icon set from the SVG subset
    (rect and path only) with SkiaSharp, which arrives transitively through Avalonia.Desktop (already in
    Central Package Management): no package is added by this tool.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>IconRenderer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

</Project>
