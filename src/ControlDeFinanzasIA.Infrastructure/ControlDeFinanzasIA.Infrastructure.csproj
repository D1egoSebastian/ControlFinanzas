<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ControlDeFinanzasIA.Application\ControlDeFinanzasIA.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <!-- F-013 (slice 4, D-9): AddLlmClients + the resilience pipeline. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <!-- F-018 (slice S2, D-9): report writers. Versions and license banner live in Directory.Packages.props. -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="ClosedXML" />
  </ItemGroup>

  <ItemGroup>
    <!--
      F-013 (slice 2, D-4): prompt templates shipped as embedded resources.
      WithCulture=false + an explicit LogicalName are required: the file
      names carry a locale segment ("...en.txt", "...es-DO.txt") that
      MSBuild's default AssignCulture heuristic mistakes for a satellite
      -resource culture suffix, which silently routes the two locale
      variants into separate satellite assemblies under the SAME
      collapsed logical name instead of embedding both, distinctly named,
      in the main assembly.
    -->
    <EmbeddedResource Include="Llm\Prompts\*.txt">
      <WithCulture>false</WithCulture>
      <LogicalName>ControlDeFinanzasIA.Infrastructure.Llm.Prompts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
