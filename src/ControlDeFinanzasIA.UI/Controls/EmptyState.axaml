<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ControlDeFinanzasIA.UI.Controls"
             x:Class="ControlDeFinanzasIA.UI.Controls.EmptyState"
             x:Name="Root">
    <!--
        F-021 (DD-9) empty state, "Sand and Cobalt": a calm, centered invitation. A soft cobalt disc with a glyph, the
        headline, a quiet hint and a single primary action that teaches its shortcut. Tokens only. The glyph is
        decorative and hidden from assistive technology.
    -->
    <Border Background="{DynamicResource SurfaceMutedBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            Padding="24,32">
        <StackPanel MaxWidth="440"
                    HorizontalAlignment="Center"
                    Spacing="10">
            <Border Width="56"
                    Height="56"
                    CornerRadius="28"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AccentSoftBrush}"
                    AutomationProperties.AccessibilityView="Raw">
                <local:Icon Size="26" Thickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconBrand}" Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <TextBlock Text="{Binding #Root.Title}"
                       Classes="card-title"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding #Root.Hint}"
                       Classes="ledger-status"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       IsVisible="{Binding #Root.Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Classes="ledger-btn-primary"
                    AutomationProperties.Name="{Binding #Root.ActionText}"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Command="{Binding #Root.ActionCommand}"
                    ToolTip.Tip="{Binding #Root.ShortcutText}"
                    AutomationProperties.AcceleratorKey="{Binding #Root.ShortcutText}"
                    IsVisible="{Binding #Root.ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding #Root.ActionText}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource OnAccentWashBrush}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="6,1"
                            IsVisible="{Binding #Root.ShortcutText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding #Root.ShortcutText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
