<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:views="using:ControlDeFinanzasIA.UI.Views"
             x:Class="ControlDeFinanzasIA.UI.App"
             RequestedThemeVariant="Dark">
             <!-- Dark is the single supported theme for the BOLD "Libro Mayor" design pass (F-008 P4). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ControlDeFinanzasIA.UI/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"
                      x:DataType="vm:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpensesViewModel}"
                      x:DataType="vm:ExpensesViewModel">
            <views:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncomeViewModel}"
                      x:DataType="vm:IncomeViewModel">
            <views:IncomeView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>