<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:views="using:ControlDeFinanzasIA.UI.Views"
             x:Class="ControlDeFinanzasIA.UI.App"
             RequestedThemeVariant="Dark">
             <!-- Dark is the single supported theme for the BOLD "Libro Mayor" design pass (F-008 P4). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ControlDeFinanzasIA.UI/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <views:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ControlDeFinanzasIA.UI/Styles/LedgerStyles.axaml" />
        <!-- Motion.axaml is NOT merged: its RenderTransform animations throw
             "No animator registered for the property RenderTransform" at
             runtime (Avalonia needs the transform's sub-property animated,
             not the whole RenderTransform object). Confirmed by actually
             launching the app - fixing the animation syntax is out of
             scope here; tracked as follow-up work. -->
    </Application.Styles>
</Application>
