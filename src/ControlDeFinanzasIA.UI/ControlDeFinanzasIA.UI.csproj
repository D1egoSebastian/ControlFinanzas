<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icon\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <UseAvaloniaApp>true</UseAvaloniaApp>
  </PropertyGroup>

  <Import Project="..\..\build\Publish.props" />

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Design-time only (the dotnet ef startup project needs it next to the startup project). The runtime assets,
      and the Roslyn / T4 assemblies it pulls in, are excluded whenever a RuntimeIdentifier is set (publish), so they
      never ship. Plain builds and tests keep the default assets.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets Condition="'$(RuntimeIdentifier)' != ''">runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.es-DO.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlDeFinanzasIA.Application\ControlDeFinanzasIA.Application.csproj" />
    <ProjectReference Include="..\ControlDeFinanzasIA.Domain\ControlDeFinanzasIA.Domain.csproj" />
    <ProjectReference Include="..\ControlDeFinanzasIA.Infrastructure\ControlDeFinanzasIA.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**" />
    <AvaloniaResource Include="Assets\Icon\*.ico;Assets\Icon\*.png" />
  </ItemGroup>

</Project>
