<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:domain="using:ControlDeFinanzasIA.Domain.Recurring"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             xmlns:controls="using:ControlDeFinanzasIA.UI.Controls"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             x:Class="ControlDeFinanzasIA.UI.Views.RecurringRulesView"
             x:DataType="vm:RecurringRulesViewModel"
             x:Name="Root"
             Background="{DynamicResource CanvasBrush}">
    <ScrollViewer>
        <StackPanel Margin="32,4,32,32" Spacing="20">
            <!-- Page header -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static resources:Strings.RecurringTitle}" Classes="page-title" />
                <TextBlock Text="{x:Static resources:Strings.RecurringSubtitle}" Classes="page-subtitle" />
            </StackPanel>

            <!-- Rule form: one compact card, wrapping fields, Save is the one primary action. -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="icon-chip" AutomationProperties.AccessibilityView="Raw">
                            <controls:Icon Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconRecurring}" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{x:Static resources:Strings.RecurringFormTitle}" Classes="card-title" VerticalAlignment="Center" />
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Spacing="4" Width="240" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.RecurringFieldType}" Classes="field-label" />
                            <ComboBox AutomationProperties.Name="{x:Static resources:Strings.A11yRuleType}" ItemsSource="{Binding RuleTypes}" SelectedItem="{Binding RuleType}" Classes="ledger-input">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding ., Converter={x:Static converters:EnumLabelConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4" Width="300" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.RecurringNamePlaceholder}" Classes="field-label" />
                            <TextBox AutomationProperties.Name="{x:Static resources:Strings.RecurringNamePlaceholder}" Text="{Binding Name}" Watermark="{x:Static resources:Strings.RecurringNamePlaceholder}" Classes="ledger-input" />
                        </StackPanel>
                        <StackPanel Spacing="4" Width="160" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.RecurringAmountPlaceholder}" Classes="field-label" />
                            <TextBox AutomationProperties.Name="{x:Static resources:Strings.RecurringAmountPlaceholder}" Text="{Binding Amount}" Watermark="{x:Static resources:Strings.RecurringAmountPlaceholder}" Classes="ledger-input" />
                        </StackPanel>
                        <StackPanel Spacing="4" Width="120" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.A11yCurrency}" Classes="field-label" />
                            <ComboBox AutomationProperties.Name="{x:Static resources:Strings.A11yCurrency}" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" Classes="ledger-input" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding RuleTypeHelp}" Classes="caption" Margin="0,-6,0,0" />

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Spacing="4" Width="200" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.RecurringFieldFrequency}" Classes="field-label" />
                            <ComboBox AutomationProperties.Name="{x:Static resources:Strings.A11yFrequency}" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" Classes="ledger-input">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding ., Converter={x:Static converters:EnumLabelConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.RecurringDayOfMonthLabel}" Classes="field-label" IsVisible="{Binding !IsMonthVisible}" />
                            <TextBlock Text="{x:Static resources:Strings.RecurringYearlyDateLabel}" Classes="field-label" IsVisible="{Binding IsMonthVisible}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox AutomationProperties.Name="{x:Static resources:Strings.RecurringMonthOfChargeLabel}"
                                          IsVisible="{Binding IsMonthVisible}"
                                          ItemsSource="{Binding Months}"
                                          DisplayMemberBinding="{Binding Name}"
                                          SelectedValueBinding="{Binding Number}"
                                          SelectedValue="{Binding Month}"
                                          MinWidth="140"
                                          Classes="ledger-input" />
                                <ComboBox AutomationProperties.Name="{x:Static resources:Strings.RecurringDayOfMonthLabel}"
                                          ItemsSource="{Binding DaysOfMonth}"
                                          SelectedItem="{Binding DayOfMonth}"
                                          MinWidth="90"
                                          Classes="ledger-input" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4" Width="220" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.RecurringCategoryPlaceholder}" Classes="field-label" />
                            <ComboBox AutomationProperties.Name="{x:Static resources:Strings.RecurringCategoryPlaceholder}" ItemsSource="{Binding Categories}"
                                      DisplayMemberBinding="{Binding Name}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      PlaceholderText="{x:Static resources:Strings.RecurringCategoryPlaceholder}"
                                      Classes="ledger-input" />
                        </StackPanel>
                        <StackPanel Spacing="4" Width="220" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.RecurringPaymentMethodPlaceholder}" Classes="field-label" />
                            <ComboBox AutomationProperties.Name="{x:Static resources:Strings.RecurringPaymentMethodPlaceholder}" ItemsSource="{Binding PaymentMethods}"
                                      DisplayMemberBinding="{Binding Name}"
                                      SelectedItem="{Binding SelectedPaymentMethod}"
                                      PlaceholderText="{x:Static resources:Strings.RecurringPaymentMethodPlaceholder}"
                                      Classes="ledger-input" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{x:Static resources:Strings.RecurringDayOfMonthHelp}" Classes="caption" Margin="0,-6,0,0" />

                    <!-- The read-only "Next charge" line, announced when it changes. -->
                    <Border Classes="notice info">
                        <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding NextChargeText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding FormError}" Foreground="{DynamicResource ExpenseBrush}" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,10,8" />
                            </Style>
                        </WrapPanel.Styles>
                        <Button Content="{x:Static resources:Strings.RecurringSaveButton}" Command="{Binding SaveCommand}" IsDefault="True" Classes="ledger-btn-primary" />
                        <Button Content="{x:Static resources:Strings.RecurringCancelButton}" Command="{Binding CancelEditCommand}" Classes="ledger-btn" />
                        <Button Content="{x:Static resources:Strings.RecurringDeactivateButton}" Command="{Binding DeactivateSelectedCommand}" IsVisible="{Binding IsEditing}" Classes="ledger-btn" />
                        <Button Content="{x:Static resources:Strings.RecurringDeleteButton}" Command="{Binding DeleteSelectedCommand}" IsVisible="{Binding IsEditing}" Classes="ledger-btn-danger" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding StatusMessage}" Foreground="{DynamicResource IncomeBrush}" TextWrapping="Wrap" />

            <!-- Active rules: one card, hairline rows with a hover wash, right-aligned amounts in the expense colour. -->
            <TextBlock Text="{x:Static resources:Strings.RecurringActiveTitle}" Classes="card-title" FontSize="20" />
            <Border Classes="card" Padding="12,8" IsVisible="{Binding !!Rules.Count}">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:RecurringRule">
                            <Border Classes="ledger-row" Padding="8,10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Classes="strong" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Frequency, Converter={x:Static converters:EnumLabelConverter.Instance}}" Classes="caption" />
                                        <TextBlock Text="{Binding NextGenerationDate, Converter={x:Static converters:NextChargeTextConverter.Instance}}" Classes="caption" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0"
                                               VerticalAlignment="Center"
                                               Classes="ledger-amount expense">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{x:Static resources:Strings.RowAmountWithCurrencyFormat}">
                                                <Binding Path="Amount.Amount" />
                                                <Binding Path="Amount.Currency" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="{x:Static resources:Strings.RecurringEditButton}" Command="{Binding #Root.DataContext.EditCommand}" CommandParameter="{Binding}" Classes="ledger-btn ghost" />
                                        <Button Content="{x:Static resources:Strings.RecurringSkipButton}" Command="{Binding #Root.DataContext.SkipCommand}" CommandParameter="{Binding}" Classes="ledger-btn ghost" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <!-- F-021 (DD-9): shown only after a successful first load; there is no filter, so no filtered state. -->
            <controls:EmptyState Title="{x:Static resources:Strings.EmptyStateRecurringTitle}"
                                 Hint="{x:Static resources:Strings.EmptyStateRecurringHint}"
                                 IsVisible="{Binding IsEmptyNoData}" />

            <!-- "Generate for the month": preview what would be created, then confirm. -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Static resources:Strings.RecurringGenerateTitle}" Classes="card-title" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{x:Static resources:Strings.RecurringPreviewButton}" Command="{Binding PreviewGenerationCommand}" Classes="ledger-btn" />
                        <Button Content="{x:Static resources:Strings.RecurringConfirmButton}" Command="{Binding ConfirmGenerationCommand}" Classes="ledger-btn" />
                    </StackPanel>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding GenerationError}" Foreground="{DynamicResource ExpenseBrush}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PreviewItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="ledger-row" Padding="8,8">
                                    <TextBlock Classes="secondary">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{x:Static resources:Strings.RecurringPreviewItemFormat}">
                                                <Binding Path="RuleName" />
                                                <Binding Path="Amount" />
                                                <Binding Path="Currency" />
                                                <Binding Path="OccurrenceDate" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
