<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:domain="using:ControlDeFinanzasIA.Domain.Recurring"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             xmlns:controls="using:ControlDeFinanzasIA.UI.Controls"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             x:Class="ControlDeFinanzasIA.UI.Views.RecurringRulesView"
             x:DataType="vm:RecurringRulesViewModel"
             x:Name="Root"
             Background="{StaticResource InkBrush}">
    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
    </UserControl.Resources>
    <Grid ColumnDefinitions="320,*" Margin="24">
        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static resources:Strings.RecurringTitle}" Classes="ledger-title" />
                <TextBlock Text="{x:Static resources:Strings.RecurringSubtitle}" Foreground="{StaticResource PaperDimBrush}" />
                <ComboBox AutomationProperties.Name="{x:Static resources:Strings.A11yRuleType}" ItemsSource="{Binding RuleTypes}" SelectedItem="{Binding RuleType}" Classes="ledger-input" />
                <TextBox AutomationProperties.Name="{x:Static resources:Strings.RecurringNamePlaceholder}" Text="{Binding Name}" Watermark="{x:Static resources:Strings.RecurringNamePlaceholder}" Classes="ledger-input" />
                <TextBox AutomationProperties.Name="{x:Static resources:Strings.RecurringAmountPlaceholder}" Text="{Binding Amount}" Watermark="{x:Static resources:Strings.RecurringAmountPlaceholder}" Classes="ledger-input" />
                <ComboBox AutomationProperties.Name="{x:Static resources:Strings.A11yCurrency}" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" Classes="ledger-input" />
                <ComboBox AutomationProperties.Name="{x:Static resources:Strings.A11yFrequency}" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" Classes="ledger-input" />
                <DatePicker AutomationProperties.Name="{x:Static resources:Strings.A11yStartDate}" SelectedDate="{Binding StartDate, Converter={StaticResource DateOnlyConverter}}" Classes="ledger-input" />
                <ComboBox AutomationProperties.Name="{x:Static resources:Strings.RecurringCategoryPlaceholder}" ItemsSource="{Binding Categories}"
                          DisplayMemberBinding="{Binding Name}"
                          SelectedItem="{Binding SelectedCategory}"
                          PlaceholderText="{x:Static resources:Strings.RecurringCategoryPlaceholder}"
                          Classes="ledger-input" />
                <ComboBox AutomationProperties.Name="{x:Static resources:Strings.RecurringPaymentMethodPlaceholder}" ItemsSource="{Binding PaymentMethods}"
                          DisplayMemberBinding="{Binding Name}"
                          SelectedItem="{Binding SelectedPaymentMethod}"
                          PlaceholderText="{x:Static resources:Strings.RecurringPaymentMethodPlaceholder}"
                          Classes="ledger-input" />
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding FormError}" Foreground="{StaticResource TerracottaTextBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static resources:Strings.RecurringSaveButton}" Command="{Binding SaveCommand}" IsDefault="True" Classes="ledger-btn-primary" />
                    <Button Content="{x:Static resources:Strings.RecurringCancelButton}" Command="{Binding CancelEditCommand}" Classes="ledger-btn" />
                    <Button Content="{x:Static resources:Strings.RecurringDeactivateButton}" Command="{Binding DeactivateSelectedCommand}" Classes="ledger-btn" />
                    <Button Content="{x:Static resources:Strings.RecurringDeleteButton}" Command="{Binding DeleteSelectedCommand}" Classes="ledger-btn" />
                </StackPanel>
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding StatusMessage}" Foreground="{StaticResource SageBrush}" />
                <Separator Margin="0,12" />
                <TextBlock Text="{x:Static resources:Strings.RecurringGenerateTitle}" Classes="ledger-section" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static resources:Strings.RecurringPreviewButton}" Command="{Binding PreviewGenerationCommand}" Classes="ledger-btn" />
                    <Button Content="{x:Static resources:Strings.RecurringConfirmButton}" Command="{Binding ConfirmGenerationCommand}" Classes="ledger-btn-primary" />
                </StackPanel>
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding GenerationError}" Foreground="{StaticResource TerracottaTextBrush}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PreviewItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RuleName, StringFormat={}{0} — {1}}" Foreground="{StaticResource PaperDimBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1" Margin="24,0,0,0">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Static resources:Strings.RecurringActiveTitle}" Classes="ledger-title" />
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:RecurringRule">
                            <Border Classes="ledger-row" Padding="12">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Classes="ledger-section" />
                                        <TextBlock Text="{Binding Frequency}" Foreground="{StaticResource PaperDimBrush}" />
                                        <TextBlock Text="{Binding NextGenerationDate}" Foreground="{StaticResource PaperDimBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Amount.Amount, StringFormat={}{0:N2}}"
                                               Classes="ledger-amount" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                                        <Button Content="{x:Static resources:Strings.RecurringEditButton}" Command="{Binding #Root.DataContext.EditCommand}" CommandParameter="{Binding}" Classes="ledger-btn" />
                                        <Button Content="{x:Static resources:Strings.RecurringSkipButton}" Command="{Binding #Root.DataContext.SkipSelectedCommand}" Classes="ledger-btn" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- F-021 (DD-9): shown only after a successful first load; there is no filter, so no filtered state. -->
                <controls:EmptyState Title="{x:Static resources:Strings.EmptyStateRecurringTitle}"
                                     Hint="{x:Static resources:Strings.EmptyStateRecurringHint}"
                                     IsVisible="{Binding IsEmptyNoData}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
