<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             xmlns:behaviors="using:ControlDeFinanzasIA.UI.Behaviors"
             x:Class="ControlDeFinanzasIA.UI.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             x:Name="Root"
             Background="{DynamicResource CanvasBrush}">
    <UserControl.Styles>
        <!-- Message bubbles: the assistant's sit on a white card, the user's on the accent wash. -->
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16,16,16,4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MaxWidth" Value="520" />
        </Style>
        <Style Selector="Border.bubble.user">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="16,16,4,16" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,320" RowDefinitions="Auto,*" Margin="32,4,32,32">

        <!-- Page header: title + subtitle, and the one secondary action (a fresh conversation). -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{x:Static resources:Strings.ChatTitle}" Classes="page-title" />
                <TextBlock Text="{x:Static resources:Strings.ChatSubtitle}" Classes="page-subtitle" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{x:Static resources:Strings.ChatNewConversationButton}"
                    Command="{Binding NewConversationCommand}"
                    Classes="ledger-btn"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Left column: conversation (F-015, R-1, R-9, D-10) -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto" Margin="0,0,24,0">

            <!-- "AI not configured" banner (D3, R-12) -->
            <Border Grid.Row="0"
                    Classes="notice info"
                    IsVisible="{Binding ShowNotConfiguredBanner}"
                    Margin="0,0,0,12">
                <TextBlock Text="{x:Static resources:Strings.ChatAiNotConfiguredBanner}"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Transcript (D2, S-12): auto-scrolls to the newest message -->
            <Border Grid.Row="1" Classes="card" Padding="0">
                <ScrollViewer behaviors:ScrollToEndOnCollectionChanged.Observe="{Binding Messages}">
                    <StackPanel Spacing="12" Margin="20">
                        <TextBlock Text="{x:Static resources:Strings.ChatEmptyState}"
                                   IsVisible="{Binding !Messages.Count}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,40"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatMessageItem">
                                    <!--
                                        Role-aligned bubble (D-10): User bubbles align right, Assistant
                                        replies/notes align left. IsNote drives muted styling (R-9, R-12);
                                        State colours the message text (R-6, S-6).
                                    -->
                                    <Border Classes="bubble"
                                            Classes.user="{Binding IsUser}"
                                            Margin="0,0,0,12"
                                            Opacity="{Binding IsNote, Converter={x:Static converters:BoolToOpacityConverter.Instance}}"
                                            HorizontalAlignment="{Binding Role, Converter={x:Static converters:ChatMessageRoleAlignmentConverter.Instance}}">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Role, Converter={x:Static converters:ChatMessageRoleLabelConverter.Instance}}"
                                                           Classes="ledger-section"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,16,0" />
                                                <Button Grid.Column="1"
                                                        Content="{x:Static resources:Strings.ChatCopyButton}"
                                                        Command="{Binding #Root.DataContext.CopyCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding State, Converter={x:Static converters:ChatMessageCopyableConverter.Instance}}"
                                                        Classes="ledger-btn ghost"
                                                        Padding="8,0"
                                                        MinHeight="26"
                                                        FontSize="12" />
                                            </Grid>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding State, Converter={x:Static converters:ChatMessageStateBrushConverter.Instance}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Input bar: TextBox + Send (the primary action) / Stop (R-4, R-9, D-10) -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                <TextBox AutomationProperties.Name="{x:Static resources:Strings.ChatInputPlaceholder}" Grid.Column="0"
                         Text="{Binding QuestionText}"
                         Watermark="{x:Static resources:Strings.ChatInputPlaceholder}"
                         IsEnabled="{Binding IsInputEnabled}"
                         MaxLength="500"
                         Classes="ledger-input">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Content="{x:Static resources:Strings.ChatSendButton}"
                        Command="{Binding SendCommand}"
                        Classes="ledger-btn-primary"
                        Margin="8,0,0,0" />
                <Button Grid.Column="2"
                        Content="{x:Static resources:Strings.ChatStopButton}"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding IsSending}"
                        Classes="ledger-btn-danger"
                        Margin="8,0,0,0" />
            </Grid>

            <!-- Permanent privacy disclosure (R-11, D13) -->
            <TextBlock Grid.Row="3"
                       Text="{Binding PrivacyDisclosure}"
                       Classes="caption"
                       Margin="4,8,0,0" />
        </Grid>

        <!-- Right column: exact-figure backup panel, from the DTO, never from LLM text (R-10, D12) -->
        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <Border Classes="card" Padding="20" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.ChatFiguresTitle}" Classes="card-title" />
                    <TextBlock Text="{Binding FiguresMonthLabel}" Classes="secondary" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.ChatFiguresExpensesLabel}" Classes="secondary" />
                        <TextBlock Grid.Column="1" Text="{Binding FiguresExpenses}" Classes="ledger-amount expense" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.ChatFiguresIncomesLabel}" Classes="secondary" />
                        <TextBlock Grid.Column="1" Text="{Binding FiguresIncomes}" Classes="ledger-amount income" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.ChatFiguresNetLabel}" Classes="secondary" />
                        <TextBlock Grid.Column="1" Text="{Binding FiguresNet}" Classes="ledger-amount" />
                    </Grid>

                    <Border Classes="divider" Margin="0,4" />

                    <TextBlock Text="{x:Static resources:Strings.ChatFiguresEmpty}"
                               IsVisible="{Binding !FigureLines.Count}"
                               TextWrapping="Wrap"
                               Classes="secondary" />

                    <ItemsControl ItemsSource="{Binding FigureLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatFigureLine">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" Classes="ledger-amount" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="notice error" IsVisible="{Binding FiguresHaveMissingRates}">
                        <TextBlock Text="{x:Static resources:Strings.ChatFiguresMissingRates}"
                                   Foreground="{DynamicResource ExpenseBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
