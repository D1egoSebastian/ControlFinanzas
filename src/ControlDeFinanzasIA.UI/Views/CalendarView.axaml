<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:calendar="using:ControlDeFinanzasIA.UI.Views.Calendar"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             x:Class="ControlDeFinanzasIA.UI.Views.CalendarView"
             x:DataType="vm:CalendarViewModel"
             Background="{DynamicResource CanvasBrush}">
    <ScrollViewer>
        <StackPanel Margin="32,4,32,32" Spacing="20">
            <!-- Page header -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static resources:Strings.CalendarTitle}" Classes="page-title" />
                <TextBlock Text="{x:Static resources:Strings.CalendarSubtitle}" Classes="page-subtitle" />
            </StackPanel>

            <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding LoadError}" Foreground="{DynamicResource ExpenseBrush}" TextWrapping="Wrap" />

            <!-- "Tasa no disponible" notice, same pattern as Dashboard (R-7) -->
            <Border Classes="notice info" IsVisible="{Binding HasMissingRates}">
                <TextBlock Text="{x:Static resources:Strings.DashboardMissingRatesNotice}"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- The month card: its name and total, the navigation, the weekday row and the day grid (R-1, R-2, R-3, R-7, D-6). -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding SelectedMonthLabel}" Classes="card-title" FontSize="22" />
                            <TextBlock Text="{Binding MonthTotalDisplay}" Classes="ledger-amount expense" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{x:Static resources:Strings.DashboardPreviousMonthButton}"
                                Command="{Binding PreviousMonthCommand}"
                                Classes="ledger-btn" />
                        <Button Grid.Column="2"
                                Content="{x:Static resources:Strings.DashboardNextMonthButton}"
                                Command="{Binding NextMonthCommand}"
                                Classes="ledger-btn"
                                Margin="8,0,0,0" />
                    </Grid>

                    <!-- Weekday header row, spelled in the app language (R-7) -->
                    <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Classes="calendar-weekday" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Month grid: single shared template over a 6x7 UniformGrid (R-1, R-2, R-3, D-6) -->
                    <calendar:MonthGrid Cells="{Binding Cells}"
                                         DayCommand="{Binding SelectDayCommand}"
                                         EmptyText="{x:Static resources:Strings.CalendarEmptyMessage}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
