<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:calendar="using:ControlDeFinanzasIA.UI.Views.Calendar"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             x:Class="ControlDeFinanzasIA.UI.Views.CalendarView"
             x:DataType="vm:CalendarViewModel"
             Background="{StaticResource CanvasBrush}">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">

            <TextBlock Text="{x:Static resources:Strings.CalendarTitle}" Classes="ledger-section" />

            <!-- Month header + navigation (R-1, R-7) -->
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedMonthLabel}"
                           Classes="ledger-title"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{x:Static resources:Strings.DashboardPreviousMonthButton}"
                        Command="{Binding PreviousMonthCommand}"
                        Classes="ledger-btn" />
                <Button Grid.Column="2"
                        Content="{x:Static resources:Strings.DashboardNextMonthButton}"
                        Command="{Binding NextMonthCommand}"
                        Classes="ledger-btn"
                        Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="{Binding MonthTotalDisplay}" Classes="ledger-amount" HorizontalAlignment="Left" />

            <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding LoadError}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" />

            <!-- "Tasa no disponible" notice, same pattern as Dashboard (R-7) -->
            <Border Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="12,8"
                    IsVisible="{Binding HasMissingRates}">
                <TextBlock Text="{x:Static resources:Strings.DashboardMissingRatesNotice}"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Weekday header row, localized via CultureInfo.CurrentCulture (R-7) -->
            <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   HorizontalAlignment="Center"
                                   Classes="ledger-section" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Month grid: single shared template over a 6x7 UniformGrid (R-1, R-2, R-3, D-6) -->
            <calendar:MonthGrid Cells="{Binding Cells}"
                                 DayCommand="{Binding SelectDayCommand}"
                                 EmptyText="{x:Static resources:Strings.CalendarEmptyMessage}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
