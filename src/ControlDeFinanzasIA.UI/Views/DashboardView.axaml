<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:charts="using:ControlDeFinanzasIA.UI.Views.Charts"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             x:Class="ControlDeFinanzasIA.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{StaticResource InkBrush}">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">

            <!-- Period navigation (R-1) -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedMonthLabel}"
                           Classes="ledger-title"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{x:Static resources:Strings.DashboardPreviousMonthButton}"
                        Command="{Binding PreviousMonthCommand}"
                        Classes="ledger-btn" />
                <Button Grid.Column="2"
                        Content="{x:Static resources:Strings.DashboardNextMonthButton}"
                        Command="{Binding NextMonthCommand}"
                        Classes="ledger-btn"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3"
                        Content="{x:Static resources:Strings.DashboardRefreshButton}"
                        Command="{Binding RefreshCommand}"
                        Classes="ledger-btn-primary"
                        Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource TerracottaBrush}" TextWrapping="Wrap" />

            <!-- "Tasa no disponible" notice (R-7, S-6) -->
            <Border Background="#221F232B"
                    BorderBrush="{StaticResource AmberBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="12,8"
                    IsVisible="{Binding HasMissingRates}">
                <TextBlock Text="{x:Static resources:Strings.DashboardMissingRatesNotice}"
                           Foreground="{StaticResource AmberBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Summary card (R-2) -->
            <Grid ColumnDefinitions="*,*,*">
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="0,0,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static resources:Strings.DashboardExpensesLabel}" Classes="ledger-section" />
                        <TextBlock Text="{Binding TotalExpensesDisplay}" Classes="ledger-amount expense" FontSize="20" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ExpensesDeltaDisplay}" Classes="ledger-status" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static resources:Strings.DashboardIncomesLabel}" Classes="ledger-section" />
                        <TextBlock Text="{Binding TotalIncomesDisplay}" Classes="ledger-amount income" FontSize="20" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="8,0,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static resources:Strings.DashboardNetBalanceLabel}" Classes="ledger-section" />
                        <TextBlock Text="{Binding NetBalanceDisplay}" Classes="ledger-amount" FontSize="20" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts (R-4, R-5) -->
            <Grid ColumnDefinitions="*,*">
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="0,0,8,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Static resources:Strings.DashboardCategoryBreakdownTitle}" Classes="ledger-section" />
                        <charts:CategoryBreakdownChart
                            Series="{Binding CategorySeries}"
                            IsEmpty="{Binding !CategorySlices.Count}"
                            EmptyText="{x:Static resources:Strings.DashboardEmptyCategoryBreakdownMessage}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="8,0,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Static resources:Strings.DashboardMonthlyEvolutionTitle}" Classes="ledger-section" />
                        <charts:MonthlyEvolutionChart
                            Series="{Binding EvolutionSeries}"
                            XAxes="{Binding EvolutionXAxes}"
                            IsEmpty="{Binding !EvolutionPoints.Count}"
                            EmptyText="{x:Static resources:Strings.DashboardEmptyMonthlyEvolutionMessage}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
