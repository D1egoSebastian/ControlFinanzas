<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             x:Class="ControlDeFinanzasIA.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="#16181D">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">
            <TextBlock Text="Panel financiero" Foreground="#E8E4D9" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Controla tus movimientos y consulta el estado de tu economía desde un solo lugar."
                       Foreground="#A9AFB8" FontSize="15" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*,*" Margin="0,12,0,0">
                <Border Grid.Column="0" Background="#242932" CornerRadius="10" Padding="20" Margin="0,0,8,0">
                    <StackPanel Spacing="8"><TextBlock Text="Gastos" Foreground="#E8A33D" FontSize="16" FontWeight="Bold" /><TextBlock Text="Registra, edita y filtra tus gastos." Foreground="#E8E4D9" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#242932" CornerRadius="10" Padding="20" Margin="8,0">
                    <StackPanel Spacing="8"><TextBlock Text="Ingresos" Foreground="#71C7A4" FontSize="16" FontWeight="Bold" /><TextBlock Text="Mantén tus ingresos organizados." Foreground="#E8E4D9" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#242932" CornerRadius="10" Padding="20" Margin="8,0,0,0">
                    <StackPanel Spacing="8"><TextBlock Text="Recurrentes" Foreground="#8DB7E8" FontSize="16" FontWeight="Bold" /><TextBlock Text="Automatiza movimientos periódicos." Foreground="#E8E4D9" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>
            <Border Background="#1F232B" CornerRadius="10" Padding="20" Margin="0,8,0,0">
                <StackPanel Spacing="8"><TextBlock Text="Bienvenido" Foreground="#E8E4D9" FontSize="18" FontWeight="Bold" /><TextBlock Text="Usa el menú lateral para abrir cada módulo. Los datos se almacenan localmente en SQLite." Foreground="#A9AFB8" TextWrapping="Wrap" /></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
