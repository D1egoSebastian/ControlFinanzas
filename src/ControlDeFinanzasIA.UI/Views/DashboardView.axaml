<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:charts="using:ControlDeFinanzasIA.UI.Views.Charts"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             xmlns:dashboard="using:ControlDeFinanzasIA.Application.UseCases.Dashboard.GetUpcomingPayments"
             x:Class="ControlDeFinanzasIA.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:Name="Root"
             Background="{StaticResource InkBrush}">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">

            <!-- Period navigation (R-1) -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedMonthLabel}"
                           Classes="ledger-title"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{x:Static resources:Strings.DashboardPreviousMonthButton}"
                        Command="{Binding PreviousMonthCommand}"
                        Classes="ledger-btn" />
                <Button Grid.Column="2"
                        Content="{x:Static resources:Strings.DashboardNextMonthButton}"
                        Command="{Binding NextMonthCommand}"
                        Classes="ledger-btn"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3"
                        Content="{x:Static resources:Strings.DashboardRefreshButton}"
                        Command="{Binding RefreshCommand}"
                        Classes="ledger-btn-primary"
                        Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource TerracottaBrush}" TextWrapping="Wrap" />

            <!-- "Tasa no disponible" notice (R-7, S-6) -->
            <Border Background="#221F232B"
                    BorderBrush="{StaticResource AmberBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="12,8"
                    IsVisible="{Binding HasMissingRates}">
                <TextBlock Text="{x:Static resources:Strings.DashboardMissingRatesNotice}"
                           Foreground="{StaticResource AmberBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Summary card (R-2) -->
            <Grid ColumnDefinitions="*,*,*">
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="0,0,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static resources:Strings.DashboardExpensesLabel}" Classes="ledger-section" />
                        <TextBlock Text="{Binding TotalExpensesDisplay}" Classes="ledger-amount expense" FontSize="20" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ExpensesDeltaDisplay}" Classes="ledger-status" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static resources:Strings.DashboardIncomesLabel}" Classes="ledger-section" />
                        <TextBlock Text="{Binding TotalIncomesDisplay}" Classes="ledger-amount income" FontSize="20" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="8,0,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static resources:Strings.DashboardNetBalanceLabel}" Classes="ledger-section" />
                        <TextBlock Text="{Binding NetBalanceDisplay}" Classes="ledger-amount" FontSize="20" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts (R-4, R-5) -->
            <Grid ColumnDefinitions="*,*">
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="0,0,8,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Static resources:Strings.DashboardCategoryBreakdownTitle}" Classes="ledger-section" />
                        <charts:CategoryBreakdownChart
                            Series="{Binding CategorySeries}"
                            IsEmpty="{Binding !CategorySlices.Count}"
                            EmptyText="{x:Static resources:Strings.DashboardEmptyCategoryBreakdownMessage}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20" Margin="8,0,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Static resources:Strings.DashboardMonthlyEvolutionTitle}" Classes="ledger-section" />
                        <charts:MonthlyEvolutionChart
                            Series="{Binding EvolutionSeries}"
                            XAxes="{Binding EvolutionXAxes}"
                            IsEmpty="{Binding !EvolutionPoints.Count}"
                            EmptyText="{x:Static resources:Strings.DashboardEmptyMonthlyEvolutionMessage}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- "Próximos pagos" (R-6, R-1a): anchored to today, not the -->
            <!-- selected month; does not change on PreviousMonth/NextMonth. -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.DashboardUpcomingPaymentsTitle}" Classes="ledger-section" />
                    <ItemsControl ItemsSource="{Binding UpcomingPayments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:UpcomingPaymentItem">
                                <Border Classes="ledger-row" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Date}"
                                                   Foreground="{StaticResource PaperDimBrush}"
                                                   Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" Classes="ledger-section" />
                                            <TextBlock Text="{Binding Kind, Converter={x:Static converters:UpcomingPaymentKindLabelConverter.Instance}}"
                                                       Foreground="{StaticResource PaperDimBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Amount, Converter={x:Static converters:MoneyApproximateConverter.Instance}}"
                                                   Classes="ledger-amount"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Static resources:Strings.DashboardEmptyUpcomingPaymentsMessage}"
                               IsVisible="{Binding !UpcomingPayments.Count}"
                               Foreground="{StaticResource PaperDimBrush}" />
                </StackPanel>
            </Border>

            <!-- Budget-progress card (F-010, R-7, D-11): one bar per budgeted -->
            <!-- category for SelectedMonth — reuses the Dashboard's own month -->
            <!-- navigation, no second month selector. -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.DashboardBudgetProgressTitle}" Classes="ledger-section" />
                    <ItemsControl ItemsSource="{Binding BudgetProgress}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BudgetProgressItem">
                                <Border Classes="ledger-row" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding CategoryName}"
                                                   Classes="ledger-section" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding PercentDisplay}"
                                                   Classes="ledger-amount" />
                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressValue}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Classes="budget-progress"
                                                     Classes.near="{Binding IsNear}"
                                                     Classes.exceeded="{Binding IsExceeded}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding AmountsDisplay}"
                                                   Foreground="{StaticResource PaperDimBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Static resources:Strings.DashboardEmptyBudgetProgressMessage}"
                               IsVisible="{Binding !BudgetProgress.Count}"
                               Foreground="{StaticResource PaperDimBrush}" />
                </StackPanel>
            </Border>

            <!-- Month-end forecast card (F-014, R-1, R-9): zero LLM, always -->
            <!-- numeric; ForecastStateMessage/ForecastBudgetDisplay follow the -->
            <!-- LoadError pattern above (bound directly, blank when empty). -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.DashboardForecastTitle}" Classes="ledger-section" />
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasForecast}">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="{x:Static resources:Strings.DashboardForecastSpentToDateLabel}"
                                       Foreground="{StaticResource PaperDimBrush}" />
                            <TextBlock Text="{Binding ForecastSpentToDateDisplay}" Classes="ledger-amount" FontSize="20" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                            <TextBlock Text="{x:Static resources:Strings.DashboardForecastProjectedLabel}"
                                       Foreground="{StaticResource PaperDimBrush}" />
                            <TextBlock Text="{Binding ForecastProjectedDisplay}" Classes="ledger-amount" FontSize="20" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ForecastBudgetDisplay}"
                               Foreground="{Binding ForecastBudgetStatus, Converter={x:Static converters:BudgetStatusBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding ForecastStateMessage}"
                               Foreground="{StaticResource PaperDimBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Anomalies list (F-014, R-2, R-3, R-9): severity chip + per-row -->
            <!-- dismiss; Message shows the deterministic template until narration -->
            <!-- (S8b) replaces it in place. AnomalyNarrationStatusText mirrors the -->
            <!-- LoadError pattern — bound directly, blank when narration succeeded. -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.DashboardAnomaliesTitle}" Classes="ledger-section" />
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnomalyListItem">
                                <Border Classes="ledger-row" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0"
                                                Background="{Binding Severity, Converter={x:Static converters:AnomalySeverityBrushConverter.Instance}}"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding SeverityLabel}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding CategoryName}" Classes="ledger-section" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource PaperDimBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DateDisplay}" Foreground="{StaticResource PaperDimBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AmountDisplay}"
                                                   Classes="ledger-amount"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Content="{x:Static resources:Strings.DashboardAnomalyDismissButton}"
                                                Command="{Binding #Root.((vm:DashboardViewModel)DataContext).DismissAnomalyCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="ledger-btn"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Static resources:Strings.DashboardEmptyAnomaliesMessage}"
                               IsVisible="{Binding !Anomalies.Count}"
                               Foreground="{StaticResource PaperDimBrush}" />
                    <TextBlock Text="{Binding AnomalyNarrationStatusText}"
                               Foreground="{StaticResource AmberBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- AI insights card (F-014, R-4, R-6, R-9): non-blocking narration; -->
            <!-- InsightsStatusText mirrors the LoadError pattern — bound directly, -->
            <!-- blank when InsightsText has content. -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.DashboardInsightsTitle}" Classes="ledger-section" />
                    <TextBlock Text="{x:Static resources:Strings.DashboardInsightsLoading}"
                               IsVisible="{Binding IsInsightsLoading}"
                               Foreground="{StaticResource PaperDimBrush}" />
                    <TextBlock Text="{Binding InsightsText}"
                               IsVisible="{Binding !IsInsightsLoading}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InsightsStatusText}"
                               IsVisible="{Binding !IsInsightsLoading}"
                               Foreground="{StaticResource AmberBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
