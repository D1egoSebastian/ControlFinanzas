<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:dto="using:ControlDeFinanzasIA.Application.DTOs"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             x:Class="ControlDeFinanzasIA.UI.Views.IncomeView"
             x:DataType="vm:IncomeViewModel"
             x:Name="Root"
             Background="#16181D">
    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="16">
            <TextBlock Text="Ingresos" Foreground="#E8E4D9" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Registra y administra tus ingresos." Foreground="#A9AFB8" />
            <Border Background="#242932" CornerRadius="10" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nuevo ingreso" Foreground="#71C7A4" FontSize="18" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Description}" Watermark="Descripción" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Text="{Binding Amount}" Watermark="Monto" />
                        <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Categories}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedCategoryId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Categoría" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding PaymentMethods}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedPaymentMethodId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Método de pago" />
                        <ComboBox Grid.Row="2" Grid.Column="0" ItemsSource="{x:Static converters:EnumValues.Currencies}" SelectedItem="{Binding Currency}" PlaceholderText="Moneda" />
                        <DatePicker Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" SelectedDate="{Binding Date, Converter={StaticResource DateOnlyConverter}}" />
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Note}" Watermark="Nota" AcceptsReturn="True" Height="70" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FormError}" Foreground="#F08A82" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                            <Button Content="Registrar ingreso" Command="{Binding RegisterIncomeCommand}" Background="#71C7A4" Foreground="#16181D" />
                            <Button Content="Actualizar" Command="{Binding UpdateIncomeCommand}" IsVisible="{Binding IsEditMode}" />
                            <Button Content="Cancelar" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditMode}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#71C7A4" TextWrapping="Wrap" />
            <TextBlock Text="Movimientos" Foreground="#E8E4D9" FontSize="20" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding Incomes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:IncomeDto">
                        <Border Background="#242932" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Date}" Foreground="#A9AFB8" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" Foreground="#E8E4D9" FontWeight="Bold" /><TextBlock Text="{Binding PaymentMethodName}" Foreground="#A9AFB8" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N2}}" Foreground="#71C7A4" FontSize="16" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="Editar" Command="{Binding #Root.DataContext.BeginEditCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No hay ingresos registrados." Foreground="#A9AFB8" IsVisible="{Binding !Incomes.Count}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
