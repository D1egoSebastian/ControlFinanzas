<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:views="using:ControlDeFinanzasIA.UI.Views"
             xmlns:behaviors="using:ControlDeFinanzasIA.UI.Behaviors"
             xmlns:input="using:ControlDeFinanzasIA.UI.Input"
             xmlns:controls="using:ControlDeFinanzasIA.UI.Controls"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             xmlns:dto="using:ControlDeFinanzasIA.Application.DTOs"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
             x:Class="ControlDeFinanzasIA.UI.Views.IncomeView"
             x:DataType="vm:IncomeViewModel"
             x:Name="Root"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">
            <!-- Page header -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static resources:Strings.IncomeTitle}" Classes="page-title" />
                <TextBlock Text="{x:Static resources:Strings.IncomeSubtitle}" Classes="page-subtitle" />
            </StackPanel>

            <!-- New / edit form: one compact card, the primary action is its Register button. -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="icon-chip income" AutomationProperties.AccessibilityView="Raw">
                            <controls:Icon Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconIncomes}" Foreground="{StaticResource IncomeBrush}" />
                        </Border>
                        <TextBlock Text="{x:Static resources:Strings.IncomeFormTitle}" Classes="card-title" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBox AutomationProperties.Name="{x:Static resources:Strings.IncomeDescriptionPlaceholder}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" Grid.ColumnSpan="2" Text="{Binding Description}" behaviors:FocusOnRequest.Token="{Binding DescriptionFocusRequest}" Watermark="{x:Static resources:Strings.IncomeDescriptionPlaceholder}" />
                        <TextBox AutomationProperties.Name="{x:Static resources:Strings.IncomeAmountPlaceholder}" Grid.Row="0" Grid.Column="2" Margin="0,0,0,12" Text="{Binding Amount}" Watermark="{x:Static resources:Strings.IncomeAmountPlaceholder}" />
                        <ComboBox AutomationProperties.Name="{x:Static resources:Strings.IncomeCategoryPlaceholder}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Top" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedCategoryId}" SelectedValueBinding="{Binding Id}" PlaceholderText="{x:Static resources:Strings.IncomeCategoryPlaceholder}" />
                        <ComboBox AutomationProperties.Name="{x:Static resources:Strings.IncomePaymentMethodPlaceholder}" Grid.Row="1" Grid.Column="1" Margin="0,0,12,12" VerticalAlignment="Top" HorizontalAlignment="Stretch" ItemsSource="{Binding PaymentMethods}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedPaymentMethodId}" SelectedValueBinding="{Binding Id}" PlaceholderText="{x:Static resources:Strings.IncomePaymentMethodPlaceholder}" />
                        <ComboBox AutomationProperties.Name="{x:Static resources:Strings.IncomeCurrencyPlaceholder}" Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Top" HorizontalAlignment="Stretch" ItemsSource="{x:Static converters:EnumValues.Currencies}" SelectedItem="{Binding Currency}" PlaceholderText="{x:Static resources:Strings.IncomeCurrencyPlaceholder}" />
                        <DatePicker AutomationProperties.Name="{x:Static resources:Strings.A11yDate}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" SelectedDate="{Binding Date, Converter={StaticResource DateOnlyConverter}}" />
                        <TextBox AutomationProperties.Name="{x:Static resources:Strings.IncomeNotePlaceholder}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" Grid.ColumnSpan="2" VerticalAlignment="Top" Text="{Binding Note}" Watermark="{x:Static resources:Strings.IncomeNotePlaceholder}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="96" />
                        <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding FormError}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                            <Button Content="{x:Static resources:Strings.IncomeRegisterButton}" Command="{Binding RegisterIncomeCommand}" IsDefault="{Binding !IsEditMode}" Classes="ledger-btn-primary" />
                            <Button Content="{x:Static resources:Strings.IncomeUpdateButton}" Command="{Binding UpdateIncomeCommand}" IsDefault="{Binding IsEditMode}" IsVisible="{Binding IsEditMode}" Classes="ledger-btn-primary" />
                            <Button Content="{x:Static resources:Strings.IncomeCancelButton}" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditMode}" Classes="ledger-btn" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding StatusMessage}" Foreground="{StaticResource IncomeBrush}" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.IncomeListTitle}" Classes="card-title" FontSize="20" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Classes="filter-toggle" Classes.active="{Binding HasActiveFilter}"
                              IsChecked="{Binding IsFilterPanelOpen, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Static resources:Strings.FiltersSectionTitle}"
                              IsVisible="{Binding !IsEmptyNoData}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Size="16" Data="{StaticResource IconFilter}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static resources:Strings.FiltersSectionTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
            <!-- A filter that is applied while the panel is closed stays visible: what is narrowing the list, and how to undo it. -->
            <Border Classes="notice info" IsVisible="{Binding IsFilterSummaryVisible}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.FiltersActiveSummary}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Static resources:Strings.ClearFilterButton}" Command="{Binding ClearFilterCommand}" Classes="ledger-btn ghost" />
                </Grid>
            </Border>

            <!-- Filter panel (Phase 4 deliverable restored): search, category and date range narrow the list. Collapsed behind the "Filters" toggle. -->
            <Border Classes="card" IsVisible="{Binding IsFilterPanelOpen}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Static resources:Strings.FiltersSectionTitle}" Classes="card-title" />
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Spacing="4" Width="260" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.FilterSearchLabel}" Classes="field-label" />
                            <TextBox AutomationProperties.Name="{x:Static resources:Strings.FilterSearchLabel}" Classes="ledger-input" Text="{Binding FilterText}" Watermark="{x:Static resources:Strings.FilterSearchWatermark}">
                                <!-- Enter applies the filter here; without this the window's default button would register the form above. -->
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ApplyFilterCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Spacing="4" Width="200" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.CategoryLabel}" Classes="field-label" />
                            <ComboBox AutomationProperties.Name="{x:Static resources:Strings.FilterByCategoryLabel}" Classes="ledger-input" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding FilterCategoryId}" SelectedValueBinding="{Binding Id}" PlaceholderText="{x:Static resources:Strings.FilterAllCategoriesPlaceholder}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Width="240" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.FilterDateFromLabel}" Classes="field-label" />
                            <DatePicker AutomationProperties.Name="{x:Static resources:Strings.FilterDateFromLabel}" Classes="ledger-input" HorizontalAlignment="Stretch" SelectedDate="{Binding FilterDateFrom, Converter={StaticResource DateOnlyConverter}}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Width="240" Margin="0,0,16,12">
                            <TextBlock Text="{x:Static resources:Strings.FilterDateToLabel}" Classes="field-label" />
                            <DatePicker AutomationProperties.Name="{x:Static resources:Strings.FilterDateToLabel}" Classes="ledger-input" HorizontalAlignment="Stretch" SelectedDate="{Binding FilterDateTo, Converter={StaticResource DateOnlyConverter}}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding FilterError}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" IsVisible="{Binding FilterError, Converter={x:Static avaloniaConverters:ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{x:Static resources:Strings.ApplyFilterButton}" Command="{Binding ApplyFilterCommand}" Classes="ledger-btn-primary" />
                        <Button Content="{x:Static resources:Strings.ClearFilterButton}" Command="{Binding ClearFilterCommand}" Classes="ledger-btn" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The list: one card, hairline rows with a hover wash, right-aligned amounts in the expense color. -->
            <Border Classes="card" Padding="12,8" IsVisible="{Binding !!Incomes.Count}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Incomes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:IncomeDto">
                                <Border Classes="ledger-row" Padding="8,10">
                                    <Grid ColumnDefinitions="92,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Date}" Classes="ledger-status" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" Classes="strong" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PaymentMethodName}" Classes="caption" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0">
                                            <TextBlock Classes="ledger-amount income" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{x:Static resources:Strings.RowAmountWithCurrencyFormat}">
                                                        <Binding Path="Amount" />
                                                        <Binding Path="Currency" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ConvertedAmountDisplay}" Classes="caption" HorizontalAlignment="Right" IsVisible="{Binding ConvertedAmountDisplay, Converter={x:Static avaloniaConverters:ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="{x:Static resources:Strings.IncomeEditButton}" Command="{Binding #Root.DataContext.BeginEditCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Classes="ledger-btn ghost" />
                                        <!-- Delete is two steps and stays inline: the same button turns into "Confirm" (keyboard focus stays on it) and a Cancel button appears. -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <Button Command="{Binding #Root.DataContext.DeleteIncomeCommand}" CommandParameter="{Binding}" Classes="ledger-btn-danger">
                                                <Button.Content>
                                                    <MultiBinding Converter="{x:Static converters:DeleteRowTextConverter.Instance}" ConverterParameter="label">
                                                        <Binding Path="Id" />
                                                        <Binding Path="#Root.DataContext.PendingDeleteIncomeId" />
                                                    </MultiBinding>
                                                </Button.Content>
                                                <AutomationProperties.Name>
                                                    <MultiBinding Converter="{x:Static converters:DeleteRowTextConverter.Instance}" ConverterParameter="name">
                                                        <Binding Path="Id" />
                                                        <Binding Path="#Root.DataContext.PendingDeleteIncomeId" />
                                                        <Binding Path="Description" />
                                                    </MultiBinding>
                                                </AutomationProperties.Name>
                                            </Button>
                                            <Button Content="{x:Static resources:Strings.DeleteCancelButton}" Command="{Binding #Root.DataContext.CancelDeleteCommand}" Classes="ledger-btn" AutomationProperties.Name="{Binding Description, StringFormat={x:Static resources:Strings.A11yCancelDeleteRowFormat}}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static converters:RowPendingConverter.Instance}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="#Root.DataContext.PendingDeleteIncomeId" />
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                        </StackPanel>
                                        <Border Grid.Row="1" Grid.ColumnSpan="5" Classes="notice error" Margin="0,8,0,0">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static converters:RowPendingConverter.Instance}">
                                                    <Binding Path="Id" />
                                                    <Binding Path="#Root.DataContext.PendingDeleteIncomeId" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <TextBlock Text="{x:Static resources:Strings.DeleteConfirmPrompt}" Classes="negative" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Pager: previous / next, "Page X of Y" and the total across all pages. Hidden while the list is empty. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,4" IsVisible="{Binding HasRecords}">
                        <Button Grid.Column="0" Content="{x:Static resources:Strings.PreviousPageButton}" Command="{Binding PreviousPageCommand}" Classes="ledger-btn" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding PageSummary}" Classes="strong" FontFamily="{StaticResource FontMono}" />
                            <TextBlock Text="{Binding TotalCount, StringFormat={x:Static resources:Strings.ListTotalCountFormat}}" Classes="ledger-status" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{x:Static resources:Strings.NextPageButton}" Command="{Binding NextPageCommand}" Classes="ledger-btn" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- F-021 (DD-9): "no data yet" and "no results for this filter" are distinct states; neither shows before the first load. -->
            <controls:EmptyState Title="{x:Static resources:Strings.EmptyStateIncomeTitle}"
                                 Hint="{x:Static resources:Strings.EmptyStateIncomeHint}"
                                 ActionText="{x:Static resources:Strings.EmptyStateCreateFirstAction}"
                                 ActionCommand="{Binding BeginNewEntryCommand}"
                                 ShortcutText="{x:Static input:ShortcutTexts.NewIncome}"
                                 IsVisible="{Binding IsEmptyNoData}" />
            <controls:EmptyState Title="{x:Static resources:Strings.EmptyStateFilteredTitle}"
                                 Hint="{x:Static resources:Strings.EmptyStateFilteredHint}"
                                 ActionText="{x:Static resources:Strings.EmptyStateClearFilterAction}"
                                 ActionCommand="{Binding ClearFilterCommand}"
                                 IsVisible="{Binding IsEmptyFiltered}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
