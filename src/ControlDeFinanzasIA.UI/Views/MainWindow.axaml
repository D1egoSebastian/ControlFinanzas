<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
        xmlns:nav="using:ControlDeFinanzasIA.UI.Navigation"
        xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
        xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
        x:Class="ControlDeFinanzasIA.UI.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static resources:Strings.WindowTitle}"
        MinWidth="800"
        MinHeight="600">
    <DockPanel>
        <ListBox DockPanel.Dock="Left"
                 ItemsSource="{Binding MenuItems}"
                 MinWidth="180">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="nav:RouteMenuItem">
                    <Button Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateToCommand}"
                            CommandParameter="{Binding .}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8">
                        <TextBlock Text="{Binding DisplayName}" />
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border DockPanel.Dock="Bottom"
                Padding="12,6"
                Background="DarkRed">
            <TextBlock HorizontalAlignment="Center">
                <Run Text="DEBUG Current=" />
                <Run Text="{Binding Current}" />
                <Run Text=" | type=" />
                <Run Text="{Binding Current, Converter={x:Static converters:DebugTypeConverter.Instance}}" />
            </TextBlock>
        </Border>

        <ContentControl Content="{Binding Current}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        MinHeight="400" />
    </DockPanel>
</Window>
