<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
        xmlns:nav="using:ControlDeFinanzasIA.UI.Navigation"
        xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
        xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
        x:Class="ControlDeFinanzasIA.UI.Views.MainWindow"
        x:Name="ShellRoot"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static resources:Strings.WindowTitle}"
        MinWidth="800"
        MinHeight="600">
    <DockPanel>
        <ListBox DockPanel.Dock="Left"
                 ItemsSource="{Binding MenuItems}"
                 MinWidth="180">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="nav:RouteMenuItem">
                    <Button Command="{Binding #ShellRoot.DataContext.NavigateToCommand}"
                            CommandParameter="{Binding .}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8">
                        <TextBlock Text="{Binding DisplayName}" />
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl Content="{Binding Current, Converter={x:Static converters:CurrentViewConverter.Instance}}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        MinHeight="400" />
    </DockPanel>
</Window>
