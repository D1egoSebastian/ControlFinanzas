<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
        xmlns:nav="using:ControlDeFinanzasIA.UI.Navigation"
        xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
        xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
        xmlns:views="using:ControlDeFinanzasIA.UI.Views"
        xmlns:input="using:ControlDeFinanzasIA.UI.Input"
        xmlns:behaviors="using:ControlDeFinanzasIA.UI.Behaviors"
        xmlns:controls="using:ControlDeFinanzasIA.UI.Controls"
        x:Class="ControlDeFinanzasIA.UI.Views.MainWindow"
        x:Name="ShellRoot"
        input:KeyboardShortcuts.Enabled="True"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static resources:Strings.WindowTitle}"
        Icon="/Assets/Icon/app-icon.ico"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource FontBody}"
        FontSize="14"
        MinWidth="800"
        MinHeight="600">
    <!--
        F-021 (DD-4): the root is a Panel so the error overlay sits over the whole shell. While it is open
        the shell Grid is disabled: it leaves the tab order, ignores pointer input and cannot fire an
        IsDefault button behind the overlay.

        Layout (pre-1.0 slice E): a light 216 px sidebar on the left for the full height, and on the right a slim
        header (the notification bell) above the content. The XAML order stays bell, sidebar, content, which is the
        tab order the accessibility tests pin.
    -->
    <Panel>
    <Grid ColumnDefinitions="216,*" RowDefinitions="Auto,*" IsEnabled="{Binding !IsModalOpen}">
        <!-- Header (F-017 D-10): owns the notification bell; no rule, no fill, just room to breathe. -->
        <Grid Grid.Row="0" Grid.Column="1" Height="48" Margin="0,4,24,0">
            <Grid HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <ToggleButton x:Name="BellToggle"
                              Classes="bell"
                              IsChecked="{Binding Notifications.IsOpen, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Notifications.BellAutomationName}"
                              AutomationProperties.AcceleratorKey="{Binding BellAcceleratorKey}"
                              ToolTip.Tip="{Binding BellToolTip}">
                    <controls:Icon Size="20" Data="{StaticResource IconBell}" />
                </ToggleButton>

                <!-- Unread badge: a rose pill pinned to the bell's top-right corner. -->
                <Border IsVisible="{Binding Notifications.HasUnread}"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-2,-4,0"
                        MinWidth="18"
                        Height="18"
                        Padding="5,0"
                        CornerRadius="9"
                        Background="{DynamicResource ExpenseBrush}">
                    <TextBlock Text="{Binding Notifications.BadgeText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!--
                    Flyout: a Popup (not Button.Flyout) because it needs a bindable IsOpen so that
                    opening can mark rows read from the ViewModel without code-behind (D-10).
                    The bell is a pass-through element so a click on it toggles instead of
                    light-dismissing and immediately re-opening.
                -->
                <Popup IsOpen="{Binding Notifications.IsOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding #BellToggle}"
                       Placement="BottomEdgeAlignedRight"
                       VerticalOffset="8"
                       IsLightDismissEnabled="True"
                       OverlayInputPassThroughElement="{Binding #BellToggle}">
                    <Border Width="380"
                            Margin="24"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            BoxShadow="{DynamicResource ShadowPopup}"
                            input:KeyboardShortcuts.Source="{Binding #ShellRoot.DataContext}"
                            input:KeyboardShortcuts.EscapeOnly="True"
                            input:KeyboardShortcuts.Enabled="True"
                            DataContext="{Binding Notifications}">
                        <StackPanel>
                            <!-- Popup header: title + refresh. -->
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="20,12,12,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static resources:Strings.NotificationsTitle}"
                                               Classes="card-title"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="ledger-btn ghost"
                                            Content="{x:Static resources:Strings.NotificationsRefreshButton}"
                                            Command="{Binding RefreshCommand}"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ScrollViewer MaxHeight="400"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotificationItemViewModel">
                                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="28,*,Auto">
                                                    <!-- Unread accent dot (R-16: rows are informational, not clickable). -->
                                                    <Ellipse Grid.Column="0"
                                                             IsVisible="{Binding IsUnread}"
                                                             Width="8"
                                                             Height="8"
                                                             Margin="14,18,0,0"
                                                             VerticalAlignment="Top"
                                                             HorizontalAlignment="Left"
                                                             Fill="{DynamicResource AccentBrush}" />
                                                    <StackPanel Grid.Column="1"
                                                                Margin="0,12,8,12"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Classes="strong"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Body}"
                                                                   Classes="ledger-status" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Classes="ledger-btn ghost"
                                                            Content="{x:Static resources:Strings.NotificationsDismissButton}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.DismissCommand}"
                                                            CommandParameter="{Binding .}"
                                                            FontSize="12"
                                                            Margin="0,8,8,0"
                                                            VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock IsVisible="{Binding IsEmpty}"
                                       Text="{x:Static resources:Strings.NotificationsEmpty}"
                                       Classes="ledger-status"
                                       HorizontalAlignment="Center"
                                       Margin="16,28" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!--
            F-021 (DD-7): the rail. One flat Button per section (single tab stop, Enter/Space activate,
            arrow keys and Tab move between items); no ListBox, so no Button nested in a selectable item.
        -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand: a cobalt tile with a rising-bars mark, then the product name. -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="16,22,16,14"
                            AutomationProperties.AccessibilityView="Raw">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="10"
                            Background="{DynamicResource AccentBrush}">
                        <controls:Icon Size="20" Thickness="2.4" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource IconBrand}" Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                    <TextBlock Text="{x:Static resources:Strings.WindowTitle}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="148" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SidebarItems}"
                                  XYFocus.NavigationModes="Keyboard"
                                  Margin="12,4,12,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                <Button Classes="sidebar-item"
                                        Classes.current="{Binding IsCurrent}"
                                        Command="{Binding #ShellRoot.DataContext.OpenSidebarItemCommand}"
                                        CommandParameter="{Binding .}"
                                        AutomationProperties.Name="{Binding Label}"
                                        AutomationProperties.ItemStatus="{Binding ItemStatus}"
                                        AutomationProperties.PositionInSet="{Binding PositionInSet}"
                                        AutomationProperties.SizeOfSet="{Binding SizeOfSet}"
                                        AutomationProperties.AcceleratorKey="{Binding ShortcutText}"
                                        ToolTip.Tip="{Binding ShortcutText}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <controls:Icon Grid.Column="0" Size="18" Margin="0,0,12,0" Data="{Binding Route, Converter={x:Static converters:RouteIconConverter.Instance}}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Classes="sidebar-hint"
                                                   Text="{Binding DigitHint}"
                                                   IsHitTestVisible="False"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding Current, Converter={x:Static converters:CurrentViewConverter.Instance}}"
                        behaviors:FocusOnRequest.FirstFocusableToken="{Binding ContentFocusRequest}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        MinHeight="400" />
    </Grid>

    <views:ErrorOverlayView DataContext="{Binding ErrorOverlay}"
                            IsVisible="{Binding IsOpen, FallbackValue=False}" />
    </Panel>
</Window>
