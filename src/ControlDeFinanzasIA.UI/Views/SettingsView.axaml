<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
             x:Class="ControlDeFinanzasIA.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{StaticResource InkBrush}">
    <ScrollViewer>
        <StackPanel Spacing="24" Margin="24" MaxWidth="720">

            <!-- Apariencia (R-3, S-1, S-2) -->
            <Border Classes="ledger-row" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.SettingsAppearanceTitle}" Classes="ledger-title" />

                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              DisplayMemberBinding="{Binding Label}"
                              SelectedValue="{Binding Theme}"
                              SelectedValueBinding="{Binding Value}"
                              PlaceholderText="{x:Static resources:Strings.SettingsThemeLabel}"
                              Classes="ledger-input"
                              HorizontalAlignment="Stretch" />

                    <!--
                        Always visible, never conditional on the current
                        selection (R-3, S-1, D-10): a selectable Light
                        option that silently does nothing is a defect,
                        not an acceptable v1 cut.
                    -->
                    <TextBlock Text="{x:Static resources:Strings.SettingsThemeLightNotice}"
                               Foreground="{StaticResource AmberBrush}"
                               TextWrapping="Wrap" />

                    <Button Content="{x:Static resources:Strings.SettingsSaveButton}"
                            Command="{Binding SaveThemeCommand}"
                            Classes="ledger-btn-primary" />
                </StackPanel>
            </Border>

            <!-- Idioma (R-4, S-3, S-4, S-5) -->
            <Border Classes="ledger-row" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.SettingsLanguageTitle}" Classes="ledger-title" />

                    <ComboBox ItemsSource="{Binding LocaleOptions}"
                              DisplayMemberBinding="{Binding Label}"
                              SelectedValue="{Binding Locale}"
                              SelectedValueBinding="{Binding Value}"
                              PlaceholderText="{x:Static resources:Strings.SettingsLanguageLabel}"
                              Classes="ledger-input"
                              HorizontalAlignment="Stretch" />

                    <Button Content="{x:Static resources:Strings.SettingsSaveButton}"
                            Command="{Binding SaveLocaleCommand}"
                            Classes="ledger-btn-primary" />

                    <TextBlock Text="{x:Static resources:Strings.SettingsRestartRequiredNotice}"
                               IsVisible="{Binding IsRestartRequired}"
                               Foreground="{StaticResource AmberBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- IA (R-5, R-6, S-6, S-7, S-8) -->
            <Border Classes="ledger-row" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.SettingsAiTitle}" Classes="ledger-title" />

                    <!--
                        Always visible, never conditional on whether a key
                        has been entered (R-5, S-8): the cleartext-storage
                        risk exists either way.
                    -->
                    <TextBlock Text="{x:Static resources:Strings.SettingsAiApiKeyWarning}"
                               Foreground="{StaticResource TerracottaBrush}"
                               TextWrapping="Wrap" />

                    <ComboBox ItemsSource="{Binding AiProviders}"
                              SelectedItem="{Binding AiProvider}"
                              PlaceholderText="{x:Static resources:Strings.SettingsAiProviderLabel}"
                              Classes="ledger-input"
                              HorizontalAlignment="Stretch" />

                    <TextBox Text="{Binding AiModel}"
                             Watermark="{x:Static resources:Strings.SettingsAiModelWatermark}"
                             Classes="ledger-input" />

                    <TextBox Text="{Binding AiApiKey}"
                             Watermark="{x:Static resources:Strings.SettingsAiApiKeyWatermark}"
                             PasswordChar="●"
                             Classes="ledger-input" />

                    <TextBox Text="{Binding AiBaseUrl}"
                             Watermark="{x:Static resources:Strings.SettingsAiBaseUrlWatermark}"
                             Classes="ledger-input" />

                    <TextBlock Text="{x:Static resources:Strings.SettingsAiTemperatureLabel}" />
                    <NumericUpDown Value="{Binding AiTemperature}"
                                   Minimum="0"
                                   Maximum="2"
                                   Increment="0.1"
                                   Classes="ledger-input"
                                   HorizontalAlignment="Stretch" />

                    <TextBlock Text="{x:Static resources:Strings.SettingsAiMaxTokensLabel}" />
                    <NumericUpDown Value="{Binding AiMaxTokensPerRequest}"
                                   Minimum="1"
                                   Maximum="128000"
                                   Classes="ledger-input"
                                   HorizontalAlignment="Stretch" />

                    <Button Content="{x:Static resources:Strings.SettingsSaveButton}"
                            Command="{Binding SaveAiCommand}"
                            Classes="ledger-btn-primary" />

                    <!-- "Probar conexión" (F-013, slice 7, R-8) -->
                    <Button Content="{x:Static resources:Strings.SettingsAiTestConnectionButton}"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding CanTestConnection}"
                            Classes="ledger-btn" />

                    <TextBlock Text="{Binding AiTestConnectionMessage}"
                               Foreground="{StaticResource SageBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding AiTestConnectionMessage, Converter={x:Static avaloniaConverters:ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>

            <!-- Acerca de — no controls, no save (D-10) -->
            <Border Classes="ledger-row" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.SettingsAboutTitle}" Classes="ledger-title" />
                    <TextBlock Text="{x:Static resources:Strings.WindowTitle}" />
                    <TextBlock Text="{Binding AppVersionLabel}" />
                    <TextBlock Text="{x:Static resources:Strings.SettingsAboutDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding FormError}" Foreground="{StaticResource TerracottaBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SageBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
