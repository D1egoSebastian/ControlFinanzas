<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:views="using:ControlDeFinanzasIA.UI.Views"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             xmlns:dto="using:ControlDeFinanzasIA.Application.DTOs"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
             x:Class="ControlDeFinanzasIA.UI.Views.ExpensesView"
             x:DataType="vm:ExpensesViewModel"
             x:Name="Root"
             Background="#16181D">
    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="16">
            <TextBlock Text="Gastos" Foreground="#E8E4D9" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Registra y administra tus gastos." Foreground="#A9AFB8" />
            <Border Background="#242932" CornerRadius="10" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nuevo gasto" Foreground="#E8A33D" FontSize="18" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Description}" Watermark="Descripción" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Text="{Binding Amount}" Watermark="Monto" />
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedCategoryId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Categoría" />
                            <!-- F-013 slice 6 (R-5, D-13): AI suggestion chip. Accepting it is the ONLY code path that writes SelectedCategoryId from AI output. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{Binding IsSuggestionLoading, Converter={x:Static converters:BoolToOpacityConverter.Instance}}" IsVisible="{Binding IsSuggestionVisible}">
                                <Button Command="{Binding AcceptSuggestionCommand}"
                                        Content="{Binding SuggestedCategoryChipLabel}"
                                        ToolTip.Tip="{Binding SuggestedCategoryAcceptHint}"
                                        Background="#242932" Foreground="#E8A33D" Padding="8,2" CornerRadius="10" FontSize="12" />
                                <Button Command="{Binding DismissSuggestionCommand}" Content="✕"
                                        ToolTip.Tip="{Binding SuggestedCategoryDismissHint}"
                                        Background="Transparent" Foreground="#A9AFB8" Padding="4,2" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding SuggestionLoadingLabel}" Foreground="#A9AFB8" FontSize="11" IsVisible="{Binding IsSuggestionLoading}" />
                            <TextBlock Text="{Binding AiStatusMessage}" Foreground="#A9AFB8" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding AiStatusMessage, Converter={x:Static avaloniaConverters:ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding PaymentMethods}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedPaymentMethodId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Método de pago" />
                        <ComboBox Grid.Row="2" Grid.Column="0" ItemsSource="{x:Static converters:EnumValues.Currencies}" SelectedItem="{Binding Currency}" PlaceholderText="Moneda" />
                        <DatePicker Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" SelectedDate="{Binding Date, Converter={StaticResource DateOnlyConverter}}" />
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Note}" Watermark="Nota" AcceptsReturn="True" Height="70" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FormError}" Foreground="#F08A82" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                            <Button Content="Registrar gasto" Command="{Binding RegisterExpenseCommand}" Background="#E8A33D" Foreground="#16181D" />
                            <Button Content="Actualizar" Command="{Binding UpdateExpenseCommand}" IsVisible="{Binding IsEditMode}" />
                            <Button Content="Cancelar" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditMode}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#71C7A4" TextWrapping="Wrap" />
            <!-- Report export (F-018) and import (F-020): secondary buttons beside the list title; outcome shows via StatusMessage/FormError. -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Movimientos" Foreground="#E8E4D9" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{x:Static resources:Strings.ExportPdfButton}"
                        Command="{Binding ExportPdfCommand}"
                        Classes="ledger-btn" />
                <Button Grid.Column="2"
                        Content="{x:Static resources:Strings.ExportExcelButton}"
                        Command="{Binding ExportExcelCommand}"
                        Classes="ledger-btn"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3"
                        Content="{x:Static resources:Strings.ImportButton}"
                        Command="{Binding OpenImportCommand}"
                        IsVisible="{Binding HasImport}"
                        Classes="ledger-btn"
                        Margin="8,0,0,0" />
            </Grid>
            <!-- Import panel (F-020, R-22): replaces the movement list in place while open; not a route. -->
            <StackPanel Spacing="12" IsVisible="{Binding IsImportOpen}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{x:Static resources:Strings.ImportTitle}"
                               Classes="ledger-title"
                               FontSize="20"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{x:Static resources:Strings.ImportCloseButton}"
                            Command="{Binding CloseImportCommand}"
                            Classes="ledger-btn" />
                </Grid>
                <views:ImportView DataContext="{Binding Import}" />
            </StackPanel>
            <StackPanel Spacing="16" IsVisible="{Binding !IsImportOpen}">
            <ItemsControl ItemsSource="{Binding Expenses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:ExpenseDto">
                        <Border Background="#242932" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Date}" Foreground="#A9AFB8" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" Foreground="#E8E4D9" FontWeight="Bold" /><TextBlock Text="{Binding PaymentMethodName}" Foreground="#A9AFB8" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N2}}" Foreground="#F08A82" FontSize="16" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="Editar" Command="{Binding #Root.DataContext.BeginEditCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No hay gastos registrados." Foreground="#A9AFB8" IsVisible="{Binding !Expenses.Count}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
