<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlDeFinanzasIA.UI.ViewModels"
             xmlns:views="using:ControlDeFinanzasIA.UI.Views"
             xmlns:behaviors="using:ControlDeFinanzasIA.UI.Behaviors"
             xmlns:controls="using:ControlDeFinanzasIA.UI.Controls"
             xmlns:resources="using:ControlDeFinanzasIA.UI.Resources"
             xmlns:dto="using:ControlDeFinanzasIA.Application.DTOs"
             xmlns:converters="using:ControlDeFinanzasIA.UI.Converters"
             xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
             x:Class="ControlDeFinanzasIA.UI.Views.ExpensesView"
             x:DataType="vm:ExpensesViewModel"
             x:Name="Root"
             Background="{StaticResource InkBrush}">
    <UserControl.Resources>
        <converters:DateOnlyConverter x:Key="DateOnlyConverter" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="16">
            <TextBlock Text="{x:Static resources:Strings.ExpensesTitle}" Foreground="{StaticResource PaperBrush}" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{x:Static resources:Strings.ExpensesSubtitle}" Foreground="{StaticResource PaperDimBrush}" />
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:Strings.ExpensesFormTitle}" Foreground="{StaticResource AmberBrush}" FontSize="18" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Description}" behaviors:FocusOnRequest.Token="{Binding DescriptionFocusRequest}" Watermark="{x:Static resources:Strings.ExpensesDescriptionPlaceholder}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Text="{Binding Amount}" Watermark="{x:Static resources:Strings.ExpensesAmountPlaceholder}" />
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedCategoryId}" SelectedValueBinding="{Binding Id}" PlaceholderText="{x:Static resources:Strings.ExpensesCategoryPlaceholder}" />
                            <!-- F-013 slice 6 (R-5, D-13): AI suggestion chip. Accepting it is the ONLY code path that writes SelectedCategoryId from AI output. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{Binding IsSuggestionLoading, Converter={x:Static converters:BoolToOpacityConverter.Instance}}" IsVisible="{Binding IsSuggestionVisible}">
                                <Button Command="{Binding AcceptSuggestionCommand}"
                                        Content="{Binding SuggestedCategoryChipLabel}"
                                        ToolTip.Tip="{Binding SuggestedCategoryAcceptHint}"
                                        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource AmberBrush}" Padding="8,2" CornerRadius="10" FontSize="12" />
                                <Button Command="{Binding DismissSuggestionCommand}" Content="✕"
                                        ToolTip.Tip="{Binding SuggestedCategoryDismissHint}"
                                        Background="Transparent" Foreground="{StaticResource PaperDimBrush}" Padding="4,2" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding SuggestionLoadingLabel}" Foreground="{StaticResource PaperDimBrush}" FontSize="11" IsVisible="{Binding IsSuggestionLoading}" />
                            <TextBlock Text="{Binding AiStatusMessage}" Foreground="{StaticResource PaperDimBrush}" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding AiStatusMessage, Converter={x:Static avaloniaConverters:ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding PaymentMethods}" DisplayMemberBinding="{Binding Name}" SelectedValue="{Binding SelectedPaymentMethodId}" SelectedValueBinding="{Binding Id}" PlaceholderText="{x:Static resources:Strings.ExpensesPaymentMethodPlaceholder}" />
                        <ComboBox Grid.Row="2" Grid.Column="0" ItemsSource="{x:Static converters:EnumValues.Currencies}" SelectedItem="{Binding Currency}" PlaceholderText="{x:Static resources:Strings.ExpensesCurrencyPlaceholder}" />
                        <DatePicker Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" SelectedDate="{Binding Date, Converter={StaticResource DateOnlyConverter}}" />
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Note}" Watermark="{x:Static resources:Strings.ExpensesNotePlaceholder}" AcceptsReturn="True" Height="70" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FormError}" Foreground="{StaticResource TerracottaTextBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                            <Button Content="{x:Static resources:Strings.ExpensesRegisterButton}" Command="{Binding RegisterExpenseCommand}" Background="{StaticResource AmberBrush}" Foreground="{StaticResource InkBrush}" />
                            <Button Content="{x:Static resources:Strings.ExpensesUpdateButton}" Command="{Binding UpdateExpenseCommand}" IsVisible="{Binding IsEditMode}" />
                            <Button Content="{x:Static resources:Strings.ExpensesCancelButton}" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditMode}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SageBrush}" TextWrapping="Wrap" />
            <!-- Report export (F-018) and import (F-020): secondary buttons beside the list title; outcome shows via StatusMessage/FormError. -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.ExpensesListTitle}" Foreground="{StaticResource PaperBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{x:Static resources:Strings.ExportPdfButton}"
                        Command="{Binding ExportPdfCommand}"
                        Classes="ledger-btn" />
                <Button Grid.Column="2"
                        Content="{x:Static resources:Strings.ExportExcelButton}"
                        Command="{Binding ExportExcelCommand}"
                        Classes="ledger-btn"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3"
                        Content="{x:Static resources:Strings.ImportButton}"
                        Command="{Binding OpenImportCommand}"
                        IsVisible="{Binding HasImport}"
                        Classes="ledger-btn"
                        Margin="8,0,0,0" />
            </Grid>
            <!-- Import panel (F-020, R-22): replaces the movement list in place while open; not a route. -->
            <StackPanel Spacing="12" IsVisible="{Binding IsImportOpen}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{x:Static resources:Strings.ImportTitle}"
                               Classes="ledger-title"
                               FontSize="20"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{x:Static resources:Strings.ImportCloseButton}"
                            Command="{Binding CloseImportCommand}"
                            Classes="ledger-btn" />
                </Grid>
                <views:ImportView DataContext="{Binding Import}" />
            </StackPanel>
            <StackPanel Spacing="16" IsVisible="{Binding !IsImportOpen}">
            <ItemsControl ItemsSource="{Binding Expenses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:ExpenseDto">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Date}" Foreground="{StaticResource PaperDimBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" Foreground="{StaticResource PaperBrush}" FontWeight="Bold" /><TextBlock Text="{Binding PaymentMethodName}" Foreground="{StaticResource PaperDimBrush}" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N2}}" Foreground="{StaticResource TerracottaTextBrush}" FontSize="16" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="{x:Static resources:Strings.ExpensesEditButton}" Command="{Binding #Root.DataContext.BeginEditCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- F-021 (DD-9): "no data yet" and "no results for this filter" are distinct states; neither shows before the first load. -->
            <controls:EmptyState Title="{x:Static resources:Strings.EmptyStateExpensesTitle}"
                                 Hint="{x:Static resources:Strings.EmptyStateExpensesHint}"
                                 ActionText="{x:Static resources:Strings.EmptyStateCreateFirstAction}"
                                 ActionCommand="{Binding BeginNewEntryCommand}"
                                 ShortcutText="Ctrl+N"
                                 IsVisible="{Binding IsEmptyNoData}" />
            <controls:EmptyState Title="{x:Static resources:Strings.EmptyStateFilteredTitle}"
                                 Hint="{x:Static resources:Strings.EmptyStateFilteredHint}"
                                 ActionText="{x:Static resources:Strings.EmptyStateClearFilterAction}"
                                 ActionCommand="{Binding ClearFilterCommand}"
                                 IsVisible="{Binding IsEmptyFiltered}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
