<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <!--
        "Sand and Cobalt" design tokens. This file holds what does NOT change with the theme variant (typography, spacing,
        motion, radii and a few Fluent metrics) and wires the two colour sets in as theme dictionaries: Tokens.Light.axaml
        and Tokens.Dark.axaml define exactly the same keys (colours, brushes, shadows and the Fluent control overrides),
        and Avalonia resolves them against the application's current theme variant. Views and styles reference every colour
        token with DynamicResource so a live theme switch re-skins them without a restart.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Light" Source="avares://ControlDeFinanzasIA.UI/Styles/Tokens.Light.axaml" />
        <ResourceInclude x:Key="Dark" Source="avares://ControlDeFinanzasIA.UI/Styles/Tokens.Dark.axaml" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- Typography: system fonts only (no bundled font files), each list ends in a font every platform has. -->
    <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI, SF Pro Text, Helvetica Neue, Noto Sans, Arial</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Semibold, SF Pro Display, Helvetica Neue, Noto Sans, Arial</FontFamily>
    <!-- Figures: the same sans with tabular numerals (set on the ledger-amount style) so columns of money line up. -->
    <FontFamily x:Key="FontMono">Segoe UI Variable Display, Segoe UI, SF Pro Display, Helvetica Neue, Noto Sans, Arial</FontFamily>

    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeLead">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizePage">28</sys:Double>
    <sys:Double x:Key="FontSizeMetric">30</sys:Double>

    <!-- Spacing scale (4 px base) -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">20</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space7">28</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>
    <sys:Double x:Key="Space10">40</sys:Double>
    <sys:Double x:Key="Space12">48</sys:Double>

    <!-- Motion durations -->
    <sys:TimeSpan x:Key="MotionFast">0:0:0.15</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionNormal">0:0:0.2</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionSlow">0:0:0.25</sys:TimeSpan>

    <!-- Corner radii: Small 6 (chips, tags), Medium 10 (inputs, sidebar items), Large 16 (cards), Pill (buttons, badges). -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!--
        Fluent control-resource metrics that do not depend on the variant. Application.Resources is searched before the
        FluentTheme's own theme dictionaries, so these re-skin the stock controls without touching their templates; the
        colour overrides of the same controls live in the two variant dictionaries.
    -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI, SF Pro Text, Helvetica Neue, Noto Sans, Arial</FontFamily>
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
    <sys:Double x:Key="DatePickerThemeMinWidth">120</sys:Double>
    <sys:Double x:Key="DatePickerThemeMaxWidth">10000</sys:Double>
</ResourceDictionary>
