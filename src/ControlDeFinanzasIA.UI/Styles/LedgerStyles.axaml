<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="using:ControlDeFinanzasIA.UI.Resources">
    <!--
        BOLD "Libro Mayor" control styles.
        Classes are explicit so these styles never leak to the shell or dashboard.
        See spec/features/phase-04/F-008-ui-capstone.spec.md §4.6.
    -->

    <!-- Ledger button: flat, paper text, amber underline on hover -->
    <Style Selector="Button.ledger-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ledger-btn:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>

    <!-- Primary CTA button -->
    <Style Selector="Button.ledger-btn-primary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ledger-btn-primary:pointerover">
        <Setter Property="Background" Value="#22E8A33D" />
    </Style>

    <!-- Danger / delete button -->
    <Style Selector="Button.ledger-btn-danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TerracottaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ledger-btn-danger:pointerover">
        <Setter Property="Foreground" Value="#F5A9A3" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox.ledger-input">
        <Setter Property="Background" Value="{StaticResource InkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBox.ledger-input:focus">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
    </Style>

    <Style Selector="ComboBox.ledger-input">
        <Setter Property="Background" Value="{StaticResource InkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="ComboBox.ledger-input:focus">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
    </Style>

    <!-- Ledger combo (BOLD): transparent, amber bottom border on hover, Fraunces for selected text -->
    <Style Selector="ComboBox.ledger-combo">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="ComboBox.ledger-combo:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
    </Style>

    <Style Selector="DatePicker.ledger-input">
        <Setter Property="Background" Value="{StaticResource InkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Ledger row -->
    <Style Selector="ListBoxItem.ledger-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="ListBoxItem.ledger-row:pointerover">
        <Setter Property="Background" Value="#0DE8A33D" />
    </Style>
    <Style Selector="ListBoxItem.ledger-row:selected">
        <Setter Property="Background" Value="#1AE8A33D" />
    </Style>

    <!-- Section headers inside the rail -->
    <Style Selector="TextBlock.ledger-section">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="500" />
        <Setter Property="Foreground" Value="{StaticResource PaperDimBrush}" />
        <Setter Property="Margin" Value="0,16,0,4" />
    </Style>

    <!-- Tabular amounts -->
    <Style Selector="TextBlock.ledger-amount">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style Selector="TextBlock.ledger-amount.income">
        <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    </Style>
    <Style Selector="TextBlock.ledger-amount.expense">
        <Setter Property="Foreground" Value="{StaticResource TerracottaTextBrush}" />
    </Style>

    <!-- Budget-progress bars (F-010, R-6, D-11): color-coded by BudgetStatus -->
    <Style Selector="ProgressBar.budget-progress">
        <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    </Style>
    <Style Selector="ProgressBar.budget-progress.near">
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>
    <Style Selector="ProgressBar.budget-progress.exceeded">
        <Setter Property="Foreground" Value="{StaticResource TerracottaBrush}" />
    </Style>

    <!-- Editorial title -->
    <Style Selector="TextBlock.ledger-title">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>

    <!-- Status message -->
    <Style Selector="TextBlock.ledger-status">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PaperDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Failed-operation variant of the status message (F-018 export errors) -->
    <Style Selector="TextBlock.ledger-status.export-error">
        <Setter Property="Foreground" Value="{StaticResource TerracottaTextBrush}" />
    </Style>

    <!-- Amber rule used under titles -->
    <Style Selector="Border.amber-rule">
        <Setter Property="Background" Value="{StaticResource AmberBrush}" />
        <Setter Property="Height" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,8,0,16" />
    </Style>

    <!-- Amber hover tick on row -->
    <Style Selector="Border.amber-tick">
        <Setter Property="Background" Value="{StaticResource AmberBrush}" />
        <Setter Property="Width" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="ListBoxItem.ledger-row:pointerover Border.amber-tick">
        <Setter Property="Width" Value="3" />
    </Style>

    <!-- Calendar day cell (F-009, Phase 9): a Button per grid cell, dimmed for adjacent-month filler (R-3) -->
    <Style Selector="Button.calendar-day">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.calendar-day:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
    </Style>
    <Style Selector="Button.calendar-day.adjacent">
        <Setter Property="Foreground" Value="{StaticResource PaperDimBrush}" />
    </Style>
    <Style Selector="Button.calendar-day.today">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!--
        F-021 (DD-8, R-17): ONE keyboard focus style. A 2 px Amber ring on the template part that draws the control's
        border, shown only for keyboard focus (:focus-visible, pinned by FocusStyleTests on Avalonia 11.2.7) so mouse
        users see no change. The rules target the template part because Fluent paints those parts itself. The presenter
        Padding is reduced by the border growth where a control already has a border, so focusing never moves content.
    -->
    <Style Selector="Button.ledger-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="10,4,10,6" />
    </Style>
    <Style Selector="Button.ledger-btn-primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="11,5" />
    </Style>
    <Style Selector="Button.ledger-btn-danger:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.calendar-day:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox.ledger-combo:focus-visible /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox.ledger-input:focus-visible /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- Text inputs show the amber border on any focus (the caret needs it for mouse users too); the same part Fluent paints. -->
    <Style Selector="TextBox.ledger-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
    </Style>

    <!--
        F-021 (DD-7): the sidebar rail. "Libro Mayor": each section is a ruled line of the ledger. The current one
        carries the amber margin tick (the amber-tick motif of the rows) on a faint amber wash, in SemiBold Paper; every
        item shows its Ctrl+digit as a mono folio number, which is how the shortcut teaches itself.
    -->
    <Style Selector="Button.sidebar-item">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PaperDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.sidebar-item /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="13,0,14,0" />
    </Style>
    <Style Selector="Button.sidebar-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style Selector="Button.sidebar-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AmberWashBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style Selector="Button.sidebar-item.current">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.sidebar-item.current /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AmberWashBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style Selector="Button.sidebar-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="3,2,2,2" />
    </Style>
    <Style Selector="TextBlock.sidebar-hint">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PaperDimBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Button.sidebar-item.current TextBlock.sidebar-hint">
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>

    <!--
        F-021 S8 (R-17, DD-11): names for the template parts of composite inputs. The template parts that take focus
        (the date picker's flyout button, the numeric input's text box and spin buttons) would otherwise be announced
        by their content type ("Avalonia.Controls.Grid") or not at all, so they repeat the name the view gives the
        composite control.
    -->
    <Style Selector="DatePicker /template/ Button#PART_FlyoutButton">
        <Setter Property="AutomationProperties.Name" Value="{Binding $parent[DatePicker].(AutomationProperties.Name)}" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="AutomationProperties.Name" Value="{x:Static resources:Strings.A11yIncreaseValue}" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="AutomationProperties.Name" Value="{x:Static resources:Strings.A11yDecreaseValue}" />
    </Style>
</Styles>
